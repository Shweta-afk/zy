# Copy to .env (never commit .env). Any OpenAI-compatible endpoint works.
# Groq (free tier): https://console.groq.com -> API Keys
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low     # gpt-oss models: keeps reasoning short and fast
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
# Optional:
# LLM_EXTRA_HEADERS={}     # extra HTTP headers as one line of JSON (e.g. a company gateway)
# TOOL_MODE=json           # use if the model does not support native tool calling
# LLM_MAX_RETRIES=8        # waits and retries when the provider rate-limits (HTTP 429)
